# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed — this .env.example is the only one that should be.

# Resend API key for HIGH-severity email alerts (HTTP-based email API —
# used instead of raw SMTP because some hosts, e.g. Hugging Face Spaces'
# free tier, block outbound SMTP sockets entirely).
# Get a free API key at https://resend.com/api-keys
# NOTE: until a custom domain is verified on Resend, the shared
# onboarding@resend.dev sender can only deliver to the email address the
# Resend account was signed up with.
RESEND_API_KEY=your_resend_api_key

# OpenWeather API key for the flood-risk forecast feature.
# Free tier key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key
